# Copia este archivo como .env y cambia los valores. NO subas el .env al repositorio.
# Genera una clave propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# --- Perfil de laboratorio (Docker en http://127.0.0.1:8000) ---
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DATABASE_PATH=/data/db.sqlite3
USAR_WHITENOISE=True

# El laboratorio usa http (sin TLS), por eso estas tres se desactivan SOLO aqui.
# En un despliegue real con HTTPS deben quedar en True (valor por defecto del proyecto).
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
